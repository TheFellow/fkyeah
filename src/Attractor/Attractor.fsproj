<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Any function marked [<TailCall>] that is not genuinely tail-recursive
         is a compile error, not a warning. Keeps the attribute meaningful. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS3569</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcpRuntime\AcpRuntime.fsproj" />
    <ProjectReference Include="..\CodingAgent\CodingAgent.fsproj" />
    <ProjectReference Include="..\McpClient\McpClient.fsproj" />
    <ProjectReference Include="..\UnifiedLlm\UnifiedLlm.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="DotParser.fs" />
    <Compile Include="Conditions.fs" />
    <Compile Include="Stylesheet.fs" />
    <Compile Include="Events.fs" />
    <Compile Include="Interviewer.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="Transforms.fs" />
    <Compile Include="ContextPrompt.fs" />
    <Compile Include="HandlerContracts.fs" />
    <Compile Include="McpHandlers.fs" />
    <Compile Include="AcpPresets.fs" />
    <Compile Include="AcpHandlers.fs" />
    <Compile Include="Handlers.fs" />
    <Compile Include="Engine.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>

</Project>
