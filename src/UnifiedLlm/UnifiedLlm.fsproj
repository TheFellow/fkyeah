<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Any function marked [<TailCall>] that is not genuinely tail-recursive
         is a compile error, not a warning. Keeps the attribute meaningful. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS3569</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Errors.fs" />
    <Compile Include="Observability.fs" />
    <Compile Include="ModelCatalogData.fs" />
    <Compile Include="ModelCatalog.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="Costing.fs" />
    <Compile Include="CircuitBreaker.fs" />
    <Compile Include="Retry.fs" />
    <Compile Include="Caching.fs" />
    <Compile Include="Middleware.fs" />
    <Compile Include="Tools.fs" />
    <Compile Include="ProviderAdapter.fs" />
    <Compile Include="HttpAdapters.fs" />
    <Compile Include="Client.fs" />
    <Compile Include="Generation.fs" />
  </ItemGroup>

</Project>
