digraph hello_pipeline {
    graph [goal="Create a hello world Python script"]

    start     [shape=Mdiamond]
    plan      [shape=box, prompt="Plan how to create a hello world script for: $goal"]
    implement [shape=tab, prompt="Write the planned script to hello.py in the working directory", goal_gate=true, retry_target="plan", max_turns=30, thread_id="impl"]
    run       [shape=parallelogram, tool_command="python3 hello.py", timeout="10s"]
    review    [shape=box, prompt="Review the execution output. Did the script produce the expected greeting?"]
    done      [shape=Msquare]

    start -> plan
    plan -> implement
    implement -> run      [condition="outcome=success"]
    implement -> plan     [condition="outcome=fail", label="Retry"]
    run -> review         [condition="outcome=success"]
    run -> implement      [condition="outcome=fail", label="Fix"]
    review -> done        [condition="outcome=success"]
    review -> implement   [condition="outcome=fail", label="Revise"]
}
